# ==============================================================================
# OpenAI API Configuration
# ==============================================================================
# Your secret OpenAI API key (starts with sk-...)
# Obtain yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Model name to use for chat completions.
# Examples: gpt-4o-mini (recommended, fast & affordable), gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI compatible base URL (e.g. for proxies, Ollama, OpenRouter)
# Leave commented out to use official OpenAI endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Application Server Settings
# ==============================================================================
HOST=127.0.0.1
PORT=8000
